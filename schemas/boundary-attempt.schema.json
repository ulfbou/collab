{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "collab/boundary-attempt/v1",
  "title": "BoundaryAttempt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "normalizationVersion",
    "attemptId",
    "boundaryIdentity",
    "operationPlanIdentity",
    "operationPlanAuthority",
    "operationPlan",
    "operations",
    "applicabilityContext",
    "receiptConclusions",
    "resumeOperationId",
    "automaticContinuationAllowed"
  ],
  "properties": {
    "schema": {
      "const": "collab/boundary-attempt/v1"
    },
    "normalizationVersion": {
      "const": "1"
    },
    "attemptId": {
      "type": "string",
      "pattern": "^sha256:boundary-attempt:v1:[0-9a-f]{64}$"
    },
    "boundaryIdentity": {
      "type": "string",
      "pattern": "^sha256:boundary:v1:[0-9a-f]{64}$"
    },
    "operationPlanIdentity": {
      "type": "string",
      "pattern": "^sha256:operation-plan:v1:[0-9a-f]{64}$"
    },
    "operationPlanAuthority": {
      "$ref": "#/$defs/operationPlanAuthority"
    },
    "operationPlan": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/operation"
      }
    },
    "applicabilityContext": {
      "$ref": "#/$defs/context"
    },
    "receiptConclusions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conclusion"
      }
    },
    "resumeOperationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "automaticContinuationAllowed": {
      "type": "boolean"
    }
  },
  "$defs": {
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "owner",
        "operationId"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "owner": {
          "enum": [
            "CANDIDATE",
            "WORKFLOW",
            "ENVIRONMENT",
            "AUTHORITY",
            "CONSISTENCY"
          ]
        },
        "operationId": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "ordinal",
        "status",
        "receiptIds"
      ],
      "properties": {
        "operationId": {
          "type": "string"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "COMPLETED",
            "FAILED",
            "NOT_ATTEMPTED"
          ]
        },
        "receiptIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^sha256:receipt:v1:[0-9a-f]{64}$"
          }
        },
        "failure": {
          "$ref": "#/$defs/failure"
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateIdentity",
        "configurationIdentity",
        "validatorIdentity"
      ],
      "properties": {
        "candidateIdentity": {
          "type": "string"
        },
        "configurationIdentity": {
          "type": "string"
        },
        "validatorIdentity": {
          "type": "string"
        }
      }
    },
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "receiptId",
        "applicable",
        "invalidators"
      ],
      "properties": {
        "operationId": {
          "type": "string"
        },
        "receiptId": {
          "type": "string"
        },
        "applicable": {
          "type": "boolean"
        },
        "invalidators": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "operationPlanAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completenessEstablished",
        "scopeConformityEstablished"
      ],
      "properties": {
        "completenessEstablished": {
          "const": true
        },
        "scopeConformityEstablished": {
          "const": true
        }
      }
    }
  }
}
