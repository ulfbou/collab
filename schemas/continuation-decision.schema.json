{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "collab/continuation-decision/v1",
  "title": "ContinuationDecision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "classifierVersion", "classifierIdentity", "boundaryIdentity", "decision", "valid", "blockedOperations", "missingDomains", "applicability", "diagnostics"],
  "properties": {
    "schema": {"const": "collab/continuation-decision/v1"},
    "classifierVersion": {"const": 1},
    "classifierIdentity": {"type": "string", "pattern": "^sha256:continuation:v1:[0-9a-f]{64}$"},
    "boundaryIdentity": {"type": "string", "pattern": "^sha256:boundary:v1:[0-9a-f]{64}$"},
    "decision": {"enum": ["EXECUTE_BOUNDARY", "REUSE_RECEIPT", "RESUME_PARTIAL_BOUNDARY", "REPAIR_NARROW_FAILURE", "WAIT_FOR_HOSTED_STATE", "REOBSERVE_STATE", "REQUEST_EVIDENCE", "REQUEST_DECISION", "REJECT_INCONSISTENT_STATE"]},
    "valid": {"const": true},
    "blockedOperations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "missingDomains": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "applicability": {
      "type": "object", "additionalProperties": false,
      "required": ["receiptPresent", "evaluated", "applicable", "invalidators"],
      "properties": {
        "receiptPresent": {"type": "boolean"}, "evaluated": {"type": "boolean"}, "applicable": {"type": "boolean"},
        "invalidators": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["field", "expected", "actual"], "properties": {"field": {"enum": ["boundaryId", "candidateIdentity", "configuration", "validator"]}, "expected": {"type": "string"}, "actual": {"type": "string"}}}}
      }
    },
    "diagnostics": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["code", "path", "message", "domains"], "properties": {"code": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}, "domains": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}}}
  }
}
